#!/usr/bin/env bash
set -e

# import pretty_print
source scripts/common

# Oh my zsh installation
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  pretty_print "${green}Installing oh-my-zsh...${neutral}"
  curl -L http://install.ohmyz.sh | sh
else
  pretty_print "${yellow}oh-my-zsh is already installed, skipping ...${neutral}"
fi

# Homebrew installation
if ! command -v brew &>/dev/null; then
  pretty_print "${green}Installing Homebrew, an OSX package manager, follow the instructions...${neutral}"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  # The installer does not put brew on this script's PATH, and on Apple Silicon
  # /opt/homebrew/bin is not on it by default, so `brew update` below would fail.
  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$brew_bin" ]; then
      eval "$("$brew_bin" shellenv)"
      break
    fi
  done
else
  pretty_print "${yellow}You already have Homebrew installed, skipping ...${neutral}"
fi

pretty_print "${green}Updating brew formulas${neutral}"
brew update

# oh-my-posh ships from a third-party tap, and Homebrew 6 refuses to load
# formulae from untrusted taps (HOMEBREW_REQUIRE_TAP_TRUST defaults to true).
# The trust store lives under $XDG_CONFIG_HOME, which the Makefile overrides, so
# a manual `brew trust` from an interactive shell does not apply here.
pretty_print "${green}Tapping and trusting oh-my-posh${neutral}"
brew tap jandedobbeleer/oh-my-posh
if brew trust --help &>/dev/null; then
  brew trust --tap jandedobbeleer/oh-my-posh
fi

brew bundle --file install/Brewfile
brew bundle --file install/Caskfile

# Installing vscode extensions
for ext in $(cat install/Codefile)
do
  pretty_print "Installing vscode extension: $ext"
  code --install-extension $ext --force
done

# install rust
curl https://sh.rustup.rs -sSf | bash -s -- -y

# Install terraform
tfenv install $TERRAFORM_VERSION
tfenv use $TERRAFORM_VERSION

pretty_print "${green}Copying configs to .configs directory${neutral}"
mkdir -p ~/.config
cp -R .config/* ~/.config

# Ghostty needs an absolute path for `command` (GUI launches inherit no shell
# PATH) and the Homebrew prefix differs between Apple Silicon and Intel.
sed -i '' "s|@BREW_PREFIX@|$(brew --prefix)|g" ~/.config/ghostty/config

# theme-switcher runs a theme engine from a checkout beside this repo; Ghostty
# and Alacritty include the files it generates.
pretty_print "${green}Installing theme-switcher${neutral}"
mkdir -p ~/.local/bin
cp local/bin/theme-switcher ~/.local/bin/theme-switcher
THEME_SWITCHER_ENGINE=${THEME_SWITCHER_ENGINE:-$HOME/projects/self/omarchy/omarchy}
if [ ! -d "$THEME_SWITCHER_ENGINE/themes" ]; then
  pretty_print "${yellow}No theme engine at $THEME_SWITCHER_ENGINE, skipping theme setup ...${neutral}"
elif [ -f ~/.local/state/theme-switcher/current/theme.name ]; then
  pretty_print "${yellow}Theme $(cat ~/.local/state/theme-switcher/current/theme.name) already set, skipping ...${neutral}"
else
  # Generate the files only: no desktop change or terminal repaint during setup.
  THEME_SWITCHER_ENGINE="$THEME_SWITCHER_ENGINE" THEME_SWITCHER_NO_DESKTOP=1 THEME_SWITCHER_TERMINALS="" \
    ~/.local/bin/theme-switcher set tokyo-night
fi

pretty_print "${green}Installing fonts${neutral}"
mkdir -p /Users/$USER/Library/Fonts
cp fonts/*.ttf /Users/$USER/Library/Fonts
cp fonts/*.otf /Users/$USER/Library/Fonts

# https://github.com/alacritty/alacritty/releases/tag/v0.11.0
defaults write -g AppleFontSmoothing -int 2

pretty_print "${green}Configuring plugins for zsh${neutral}"
[ ! -d ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions ] && \
  git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions

[ ! -d ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting ] && \
  git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting

pretty_print "${green}Changing zshrc config${neutral}"
cp .config/zsh/.zshrc /Users/$USER/.zshrc

pretty_print "Configuring vscode"
cp .config/code/settings.json /Users/$USER/Library/Application\ Support/Code/User/settings.json

if [ ! -d $HOME/.config/vifm/colors ];
then
  mkdir -p ~/.config/vifm/colors
  git clone https://github.com/vifm/vifm-colors ~/.config/vifm/colors
fi

# Install tmux plugin manager
if [ ! -d $HOME/.config/tmux/plugins ];
then
  mkdir -p $HOME/.config/tmux/plugins/tpm
  git clone https://github.com/tmux-plugins/tpm $HOME/.config/tmux/plugins/tpm
fi

# Install python if not installed
[ ! -d $HOME/.pyenv/versions/$PYTHON_VERSION ] && pyenv install $PYTHON_VERSION

pretty_print "${green}We are done!...everything looks good!${neutral}"
