# Sourced by every step in scripts/steps/. Makes a step runnable on its own,
# from anywhere: it moves to the repo root, points XDG_CONFIG_HOME at ~/.config
# and puts Homebrew on PATH when it is installed. Also the single source of the
# pinned versions below.

DOTFILES_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$DOTFILES_ROOT"

# Homebrew's tap trust store and other XDG config live in ~/.config.
export XDG_CONFIG_HOME="$HOME/.config"

# Colors.
red='\033[0;31m'
green='\033[0;32m'
neutral='\033[0m'
yellow='\033[0;33m'

# Shared functions
pretty_print() {
  printf "%b\n" "$1"
}

# The Homebrew installer does not put brew on the running script's PATH, and on
# Apple Silicon /opt/homebrew/bin is not on it by default.
load_brew_env() {
  local brew_bin
  command -v brew >/dev/null 2>&1 && return 0
  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$brew_bin" ]; then
      eval "$("$brew_bin" shellenv)"
      return 0
    fi
  done
  return 1
}
load_brew_env || true

# Steps after 10-homebrew need it.
require_brew() {
  load_brew_env || {
    pretty_print "${red}Homebrew is not installed; run: ./install.sh homebrew${neutral}"
    exit 1
  }
}

# Install the Homebrew formulae / casks given that are not installed yet, in one
# brew call; the steps keep their package lists inline. Installed ones are left
# as they are: `brew upgrade` is yours to run.
brew_missing() {
  local kind="$1" installed name missing=""
  shift
  installed=$(brew list "--$kind" -1)
  for name in "$@"; do
    # A tapped formula (owner/tap/name) is listed by its plain name.
    printf '%s\n' "$installed" | grep -qx -- "${name##*/}" || missing="$missing $name"
  done
  printf '%s' "$missing"
}
brew_formulae() {
  local missing
  missing=$(brew_missing formula "$@")
  if [ -z "$missing" ]; then
    pretty_print "${yellow}Formulae already installed, skipping: $*${neutral}"
  else
    pretty_print "${green}Installing formulae:$missing${neutral}"
    # shellcheck disable=SC2086 # names never contain spaces
    brew install --formula $missing
  fi
}
brew_casks() {
  local missing
  missing=$(brew_missing cask "$@")
  if [ -z "$missing" ]; then
    pretty_print "${yellow}Casks already installed, skipping: $*${neutral}"
  else
    pretty_print "${green}Installing casks:$missing${neutral}"
    # shellcheck disable=SC2086
    brew install --cask $missing
  fi
}

# Language and tool versions (Python, Go, Terraform, Node, AWS CLI) live in
# .config/mise/config.toml, which mise reads; steps/50-languages installs them.

# Alacritty has no Homebrew formula and its cask was disabled (unsigned, fails
# Gatekeeper), so steps/30-terminals installs the official release DMG pinned here.
ALACRITTY_VERSION=0.17.0
ALACRITTY_DMG_SHA256=ad8d7de35fb38e43184776cac6dfee05ca325caa0b6639a06a55e54e4b026620

# theme-switcher's engine (palettes, templates, renderer), fetched by
# steps/90-themes with `theme-switcher engine install`. A full commit SHA, since
# a tag can move; bump it deliberately, and CI runs tests/theme-switcher-test.sh
# against it. Currently the v4.0.4 release.
THEME_ENGINE_REF=c668141e9c42b13c80c9ca4ea108e11708c5e8a5
