# Theme colors, generated by `theme-switcher set <name>`. Optional (?) so Ghostty
# still starts before a theme has been set.
config-file = ?"~/.local/state/theme-switcher/current/theme/ghostty.conf"
# Font family, generated by `font-switcher set <family>`.
config-file = ?"~/.local/state/font-switcher/current/ghostty.conf"

window-decoration = none
window-padding-x = 10
window-padding-y = 10
font-size = 16
font-thicken = true

# @BREW_PREFIX@ is substituted by scripts/mac-setup on install. Ghostty needs an
# absolute path here (GUI launches inherit no shell PATH) and the Homebrew
# prefix differs between Apple Silicon and Intel.
initial-command = "@BREW_PREFIX@/bin/tmux"
command = "@BREW_PREFIX@/bin/tmux"
mouse-shift-capture = true
