# Theme colors, generated by `theme-switcher set <name>`. Optional (?) so Ghostty
# still starts before a theme has been set.
config-file = ?"~/.local/state/theme-switcher/current/theme/ghostty.conf"
# Font family and size, generated by `font-switcher set <family>` / `size <points>`.
config-file = ?"~/.local/state/font-switcher/current/ghostty.conf"

# Defaults below are shared with Alacritty and kitty.

# Font rendering (macOS)
font-thicken = true

# Window
window-theme = ghostty
window-decoration = none
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never

# Cursor; shell integration must not restyle it, and keeps SSH terminfo working
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor,ssh-env

# Keyboard
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Mouse
mouse-scroll-multiplier = 0.95
# Shift takes the mouse back from tmux, as in kitty and Alacritty: Shift+drag
# selects in Ghostty and Cmd+Shift+click opens links. Ghostty only detects
# links under a mouse-reporting app (tmux) while Shift is held and not
# captured, so `true` here makes links inside tmux unclickable.
mouse-shift-capture = false

# @BREW_PREFIX@ is substituted by scripts/mac-setup on install. Ghostty needs an
# absolute path here (GUI launches inherit no shell PATH) and the Homebrew
# prefix differs between Apple Silicon and Intel.
initial-command = "@BREW_PREFIX@/bin/tmux"
command = "@BREW_PREFIX@/bin/tmux"
