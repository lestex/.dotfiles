#!/usr/bin/env bash
#
# font-switcher — switch the terminal font on macOS (Ghostty, Alacritty, kitty).
#
#   font-switcher list            installed monospace font families, current one marked
#   font-switcher current         current font family and size
#   font-switcher set <family>    use a font family in every terminal
#   font-switcher size <points>   use a font size in every terminal (default 14)
#   font-switcher pick            choose a font in fzf with a live sample; Enter uses it
#   font-switcher preview <family>  the picker's preview: a rendered sample (Ghostty/kitty)
#
# Each terminal includes a generated file from ~/.local/state/font-switcher/current/
# (ghostty.conf, alacritty.toml, kitty.conf), so the choice survives the
# installer re-copying the main configs, which therefore set no font family or size.
#
# Environment:
#   FONT_SWITCHER_NO_RELOAD=1   do not signal running terminals

set -euo pipefail

STATE_DIR="$HOME/.local/state/font-switcher/current"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/font-switcher"
DEFAULT_SIZE=14

die() {
  echo "font-switcher: $*" >&2
  exit 1
}

# Monospace families from AppKit. The fixed-pitch flag alone is not enough: many
# Nerd Font "Liga" builds leave it unset, so a family also counts when the
# glyphs i, M, W and . exist and share one advance width.
#
# macOS registers new files in ~/Library/Fonts in the background, so a font
# installed a moment ago (the installer's first run) is not listed yet. Given a
# directory, the font files in it are registered for this one lookup first
# (CoreText process scope: nothing is written, nothing persists).
monospace_families() {
  osascript -l JavaScript -e '
  function run(argv) {
    ObjC.import("AppKit");
    ObjC.import("CoreText");
    const dir = argv[0];
    if (dir) {
      const files = ObjC.deepUnwrap($.NSFileManager.defaultManager.contentsOfDirectoryAtPathError(dir, null)) || [];
      for (const file of files) {
        if (/\.(ttf|otf|ttc)$/i.test(file)) {
          $.CTFontManagerRegisterFontsForURL($.NSURL.fileURLWithPath(dir + "/" + file), 1, null);
        }
      }
    }
    const fm = $.NSFontManager.sharedFontManager;
    const out = [];
    for (const family of ObjC.deepUnwrap(fm.availableFontFamilies)) {
      const members = ObjC.deepUnwrap(fm.availableMembersOfFontFamily(family)) || [];
      if (!members.length) continue;
      const font = $.NSFont.fontWithNameSize(members[0][0], 12);
      if (!font) continue;
      let width = null, mono = true;
      for (const name of ["i", "M", "W", "period"]) {
        const glyph = font.glyphWithName(name);
        if (!glyph) { mono = false; break; }
        const advance = font.advancementForGlyph(glyph).width;
        if (width === null) width = advance;
        else if (Math.abs(advance - width) > 0.01) { mono = false; break; }
      }
      if (mono) out.push(family);
    }
    return out.sort().join("\n");
  }' "$@"
}

current_font() {
  cat "$STATE_DIR/font.name" 2>/dev/null || true
}

list_fonts() {
  local current family
  current=$(current_font)

  while IFS= read -r family; do
    [[ -n $family ]] || continue
    if [[ $family == "$current" ]]; then
      echo "* $family"
    else
      echo "  $family"
    fi
  done < <(monospace_families)
}

# Resolve a requested name to an installed family, ignoring case, so the exact
# spelling written into the configs is the system's own.
resolve_family() {
  local wanted="$1"
  local family wanted_lower fonts_dir

  wanted_lower=$(printf '%s' "$wanted" | tr '[:upper:]' '[:lower:]')
  # Fonts macOS already knows first; only if that misses, register the user's
  # font files for the lookup, so a just-installed font is still accepted.
  for fonts_dir in "" "$HOME/Library/Fonts"; do
    while IFS= read -r family; do
      if [[ $(printf '%s' "$family" | tr '[:upper:]' '[:lower:]') == "$wanted_lower" ]]; then
        printf '%s' "$family"
        return 0
      fi
    done < <(monospace_families ${fonts_dir:+"$fonts_dir"})
  done
  return 1
}

write_state_file() {
  local name="$1"
  local tmp

  tmp=$(mktemp "$STATE_DIR/.$name.XXXXXX")
  cat >"$tmp"
  mv "$tmp" "$STATE_DIR/$name"
}

current_size() {
  local size
  size=$(cat "$STATE_DIR/font.size" 2>/dev/null || true)
  printf '%s' "${size:-$DEFAULT_SIZE}"
}

# Render all three terminal files from the family and size, so either can change
# without losing the other. A family not chosen yet is simply left out.
render() {
  local family="$1"
  local size="$2"

  mkdir -p "$STATE_DIR"

  {
    [[ -z $family ]] || printf 'font-family = "%s"\n' "$family"
    printf 'font-size = %s\n' "$size"
  } | write_state_file ghostty.conf

  {
    printf '[font]\nsize = %s\n' "$size"
    if [[ -n $family ]]; then
      local style
      for style in normal bold italic bold_italic; do
        printf '\n[font.%s]\nfamily = "%s"\n' "$style" "$family"
      done
    fi
  } | write_state_file alacritty.toml

  {
    [[ -z $family ]] || printf 'font_family %s\n' "$family"
    printf 'font_size %s\n' "$size"
  } | write_state_file kitty.conf

  [[ -z $family ]] || printf '%s\n' "$family" | write_state_file font.name
  printf '%s\n' "$size" | write_state_file font.size
}

set_font() {
  local requested="$1"
  local family

  # The family is written into three config syntaxes; a quote, backslash or
  # control character could end a string early in any of them.
  [[ $requested =~ ^[A-Za-z0-9\ ._+-]+$ ]] || die "unsupported characters in font name: $requested"
  family=$(resolve_family "$requested") ||
    die "'$requested' is not an installed monospace font (see: font-switcher list)"

  render "$family" "$(current_size)"
  echo "Font: $family $(current_size)pt"
  reload_terminals
}

set_size() {
  local size="$1"

  [[ $size =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "font size must be a number: $size"
  awk -v s="$size" 'BEGIN { exit !(s >= 6 && s <= 72) }' || die "font size must be between 6 and 72: $size"

  render "$(current_font)" "$size"
  echo "Font size: ${size}pt"
  reload_terminals
}

reload_terminals() {
  [[ ${FONT_SWITCHER_NO_RELOAD:-} == "1" ]] && return 0

  # Alacritty watches its imports and applies the change by itself. kitty
  # re-reads its config on SIGUSR1. Ghostty has no external reload on macOS.
  if pgrep -x kitty >/dev/null; then
    pkill -USR1 -x kitty || true
    echo "kitty: config reloaded; open a new window if the font did not change"
  fi
  if pgrep -x ghostty >/dev/null; then
    echo "Ghostty: press Cmd+Shift+, (reload config) or open a new window to apply"
  fi
}

# --- previews and the fzf picker -----------------------------------------------

# The current theme's background and foreground, so a sample looks as it will in
# the terminals; plain defaults without theme-switcher.
theme_color() {
  local key="$1" fallback="$2" value
  value=$(sed -n "s/^${key}[[:space:]]*=[[:space:]]*\"\(#[0-9A-Fa-f]\{6\}\)\".*/\1/p" \
    "$HOME/.local/state/theme-switcher/current/theme/colors.toml" 2>/dev/null | head -n 1)
  printf '%s' "${value:-$fallback}"
}

# A terminal can only draw text in its own font, so a sample is a PNG rendered
# by AppKit, cached per family and colors.
render_sample() {
  local family="$1" out="$2" bg="$3" fg="$4"
  osascript -l JavaScript - "$family" "$out" "$bg" "$fg" >/dev/null <<'JS'
ObjC.import("AppKit");
function color(hex) {
  const n = parseInt(hex.replace("#", ""), 16);
  return $.NSColor.colorWithSRGBRedGreenBlueAlpha(((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255, 1);
}
function run(argv) {
  const [family, out, bg, fg] = argv;
  const font = $.NSFontManager.sharedFontManager.fontWithFamilyTraitsWeightSize(family, 0, 5, 30);
  if (!font || font.isNil()) throw new Error("no such font: " + family);
  const lines = [family, "The quick brown fox jumps over the lazy dog", "0O 1lI | {} [] () <> != => -> === // #",
                 "fn main() { let answer = 42; }", "     "];
  const attrs = $.NSMutableDictionary.dictionary;
  attrs.setObjectForKey(font, $.NSFontAttributeName);
  attrs.setObjectForKey(color(fg), $.NSForegroundColorAttributeName);
  const pad = 36, lineH = Math.ceil(font.ascender - font.descender + font.leading) + 10;
  let width = 0;
  for (const line of lines) width = Math.max(width, $(line).sizeWithAttributes(attrs).width);
  const W = Math.ceil(width) + pad * 2, H = pad * 2 + lines.length * lineH;
  const image = $.NSImage.alloc.initWithSize($.NSMakeSize(W, H));
  image.lockFocus;
  color(bg).setFill;
  $.NSRectFill($.NSMakeRect(0, 0, W, H));
  lines.forEach((line, i) => $(line).drawAtPointWithAttributes($.NSMakePoint(pad, H - pad - (i + 1) * lineH), attrs));
  image.unlockFocus;
  const rep = $.NSBitmapImageRep.imageRepWithData(image.TIFFRepresentation);
  rep.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $()).writeToFileAtomically(out, true);
}
JS
}

# Real images only, as theme-switcher's previews: Ghostty and kitty through
# `kitten icat --unicode-placeholder` (also inside tmux); elsewhere text only.
can_show_images() {
  local term="${TERM:-}"
  if [ -n "${TMUX:-}" ]; then
    term=$(tmux display -p '#{client_termname}' 2>/dev/null || printf '%s' "$term")
  fi
  [[ $term == xterm-ghostty || $term == xterm-kitty ]] && command -v kitten >/dev/null 2>&1
}

font_styles() {
  osascript -l JavaScript - "$1" 2>/dev/null <<'JS'
ObjC.import("AppKit");
function run(argv) {
  const members = ObjC.deepUnwrap($.NSFontManager.sharedFontManager.availableMembersOfFontFamily(argv[0])) || [];
  return [...new Set(members.map(m => m[1]))].join(", ");
}
JS
}

preview_font() {
  local requested="$1" family bg fg image width height rows
  family=$(resolve_family "$requested") || { echo "$requested: not an installed monospace font"; return 0; }
  width="${FZF_PREVIEW_COLUMNS:-80}"
  height="${FZF_PREVIEW_LINES:-24}"

  if can_show_images; then
    bg=$(theme_color background "#1e1e2e")
    fg=$(theme_color foreground "#cdd6f4")
    mkdir -p "$CACHE_DIR"
    image="$CACHE_DIR/$(printf '%s' "$family" | tr ' ' '_')-${bg#\#}-${fg#\#}.png"
    [ -f "$image" ] || render_sample "$family" "$image" "$bg" "$fg" || true
    if [ -f "$image" ]; then
      rows=$(( height - 4 ))
      (( rows <= 16 )) || rows=16
      kitten icat --clear --transfer-mode=memory --unicode-placeholder --stdin=no \
        --place="${width}x${rows}@0x0" "$image" 2>/dev/null | sed '$d' | sed $'$s/$/\033[m/'
      echo
    fi
  else
    echo "$family"
    echo
    echo "(a rendered sample needs Ghostty or kitty; this terminal shows its own font)"
  fi
  echo "Styles: $(font_styles "$family")"
  [[ $family != "$(current_font)" ]] || echo "Current font, $(current_size)pt"
}

pick_font() {
  local self list current selected pos
  command -v fzf >/dev/null 2>&1 || die "the picker needs fzf (brew install fzf)"
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  list=$(monospace_families)
  current=$(current_font)
  # Start on the current font.
  pos=$(printf '%s\n' "$list" | grep -nxF -- "$current" | cut -d: -f1 || true)
  selected=$(printf '%s\n' "$list" | fzf --reverse --height 90% --prompt 'font> ' \
    --header "Enter: use this font   Esc: cancel   current: ${current:-none} ($(current_size)pt)" \
    --bind "load:pos(${pos:-1})" --preview "'$self' preview {}" --preview-window 'right,65%,border-left') || return 0
  set_font "$selected"
}

usage() {
  sed -n '3,17p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  list) list_fonts ;;
  current) echo "$(current_font) $(current_size)pt" ;;
  set) [[ -n ${2:-} ]] || die "usage: font-switcher set <family>"; set_font "$2" ;;
  size) [[ -n ${2:-} ]] || die "usage: font-switcher size <points>"; set_size "$2" ;;
  pick) pick_font ;;
  preview) [[ -n ${2:-} ]] || die "usage: font-switcher preview <family>"; preview_font "$2" ;;
  -h | --help | help) usage ;;
  *) usage; exit 1 ;;
esac
