#!/usr/bin/env bash
#
# font-switcher — switch the terminal font on macOS (Ghostty, Alacritty, kitty).
#
#   font-switcher list            installed monospace font families, current one marked
#   font-switcher current         current font family
#   font-switcher set <family>    use a font family in every terminal
#
# Each terminal includes a generated file from ~/.local/state/font-switcher/current/
# (ghostty.conf, alacritty.toml, kitty.conf), so the choice survives `make`
# re-copying the main configs, which therefore name no font family themselves.
#
# Environment:
#   FONT_SWITCHER_NO_RELOAD=1   do not signal running terminals

set -euo pipefail

STATE_DIR="$HOME/.local/state/font-switcher/current"

die() {
  echo "font-switcher: $*" >&2
  exit 1
}

# Monospace families from AppKit. The fixed-pitch flag alone is not enough: many
# Nerd Font "Liga" builds leave it unset, so a family also counts when the
# glyphs i, M, W and . exist and share one advance width.
monospace_families() {
  osascript -l JavaScript -e '
    ObjC.import("AppKit");
    const fm = $.NSFontManager.sharedFontManager;
    const out = [];
    for (const family of ObjC.deepUnwrap(fm.availableFontFamilies)) {
      const members = ObjC.deepUnwrap(fm.availableMembersOfFontFamily(family)) || [];
      if (!members.length) continue;
      const font = $.NSFont.fontWithNameSize(members[0][0], 12);
      if (!font) continue;
      let width = null, mono = true;
      for (const name of ["i", "M", "W", "period"]) {
        const glyph = font.glyphWithName(name);
        if (!glyph) { mono = false; break; }
        const advance = font.advancementForGlyph(glyph).width;
        if (width === null) width = advance;
        else if (Math.abs(advance - width) > 0.01) { mono = false; break; }
      }
      if (mono) out.push(family);
    }
    out.sort().join("\n");'
}

current_font() {
  cat "$STATE_DIR/font.name" 2>/dev/null || true
}

list_fonts() {
  local current family
  current=$(current_font)

  while IFS= read -r family; do
    [[ -n $family ]] || continue
    if [[ $family == "$current" ]]; then
      echo "* $family"
    else
      echo "  $family"
    fi
  done < <(monospace_families)
}

# Resolve a requested name to an installed family, ignoring case, so the exact
# spelling written into the configs is the system's own.
resolve_family() {
  local wanted="$1"
  local family wanted_lower

  wanted_lower=$(printf '%s' "$wanted" | tr '[:upper:]' '[:lower:]')
  while IFS= read -r family; do
    if [[ $(printf '%s' "$family" | tr '[:upper:]' '[:lower:]') == "$wanted_lower" ]]; then
      printf '%s' "$family"
      return 0
    fi
  done < <(monospace_families)
  return 1
}

write_state_file() {
  local name="$1"
  local tmp

  tmp=$(mktemp "$STATE_DIR/.$name.XXXXXX")
  cat >"$tmp"
  mv "$tmp" "$STATE_DIR/$name"
}

set_font() {
  local requested="$1"
  local family

  # The family is written into three config syntaxes; a quote, backslash or
  # control character could end a string early in any of them.
  [[ $requested =~ ^[A-Za-z0-9\ ._+-]+$ ]] || die "unsupported characters in font name: $requested"
  family=$(resolve_family "$requested") ||
    die "'$requested' is not an installed monospace font (see: font-switcher list)"

  mkdir -p "$STATE_DIR"

  write_state_file ghostty.conf <<EOF
font-family = "$family"
EOF

  write_state_file alacritty.toml <<EOF
[font.normal]
family = "$family"

[font.bold]
family = "$family"

[font.italic]
family = "$family"

[font.bold_italic]
family = "$family"
EOF

  write_state_file kitty.conf <<EOF
font_family $family
EOF

  printf '%s\n' "$family" | write_state_file font.name

  echo "Font: $family"

  [[ ${FONT_SWITCHER_NO_RELOAD:-} == "1" ]] && return 0

  # Alacritty watches its imports and applies the change by itself. kitty
  # re-reads its config on SIGUSR1. Ghostty has no external reload on macOS.
  if pgrep -x kitty >/dev/null; then
    pkill -USR1 -x kitty || true
    echo "kitty: config reloaded; open a new window if the font did not change"
  fi
  if pgrep -x ghostty >/dev/null; then
    echo "Ghostty: press Cmd+Shift+, (reload config) or open a new window to apply"
  fi
}

usage() {
  sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  list) list_fonts ;;
  current) current_font ;;
  set) [[ -n ${2:-} ]] || die "usage: font-switcher set <family>"; set_font "$2" ;;
  -h | --help | help) usage ;;
  *) usage; exit 1 ;;
esac
