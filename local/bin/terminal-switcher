#!/usr/bin/env bash
#
# terminal-switcher — choose the terminal Cmd+Ctrl+T opens.
#
#   terminal-switcher ghostty|alacritty|kitty   use this one
#   terminal-switcher                           pick one in fzf
#
# The choice goes to ~/.local/state/terminal-switcher/current, which Hammerspoon
# reads on every Cmd+Ctrl+T, so it applies on the next press. Default: ghostty.

set -euo pipefail

STATE_FILE="$HOME/.local/state/terminal-switcher/current"
TERMINALS="ghostty alacritty kitty"

die() {
  echo "terminal-switcher: $*" >&2
  exit 1
}

set_terminal() {
  case " $TERMINALS " in
    *" $1 "*) ;;
    *) die "unknown terminal \"$1\" (one of: $TERMINALS)" ;;
  esac
  mkdir -p "$(dirname "$STATE_FILE")"
  echo "$1" >"$STATE_FILE"
  echo "Terminal: $1 (Cmd+Ctrl+T)"
}

pick_terminal() {
  local current selected
  command -v fzf >/dev/null 2>&1 || die "the picker needs fzf; or run: terminal-switcher ghostty|alacritty|kitty"
  current=$(cat "$STATE_FILE" 2>/dev/null || echo ghostty)
  selected=$(printf '%s\n' $TERMINALS | fzf --reverse --height 7 --prompt 'terminal> ' \
    --header "current: $current" --bind "load:pos($(printf '%s\n' $TERMINALS | grep -nx -- "$current" | cut -d: -f1))") || return 0
  set_terminal "$selected"
}

case "${1:-}" in
  "") pick_terminal ;;
  -h | --help | help) sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) set_terminal "$1" ;;
esac
