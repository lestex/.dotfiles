#!/usr/bin/env bash
#
# theme-switcher — switch terminal and desktop themes on macOS.
#
# The theme engine is read in place from a checkout (THEME_SWITCHER_ENGINE):
# palettes (themes/*/colors.toml), templates (default/themed/*.tpl), the palette
# resolver and the template renderer, so theme and template updates there apply
# here unchanged. This script adds what is specific to macOS: running the engine
# under bash 5, repainting running terminals through their TTYs, and the desktop
# picture.
#
#   theme-switcher list                 themes, current one marked
#   theme-switcher current              current theme name
#   theme-switcher set <name>           render and apply a theme
#   theme-switcher bg next              next background of the current theme
#   theme-switcher bg set <path>        use an image as the background
#   theme-switcher bg none              solid theme background color
#   theme-switcher bg import [theme]    copy the engine's backgrounds into ~/.local/share
#   theme-switcher catalog [filter]     community themes you can install, installed ones marked
#   theme-switcher install <name|url>   clone a community theme (catalog name or git URL) and apply it
#   theme-switcher remove <name>        remove an installed theme
#   theme-switcher update               pull every installed theme
#   theme-switcher pick [--catalog]     choose a theme in fzf with a live preview; Enter applies
#                                       (--catalog: gallery themes; Enter installs)
#   theme-switcher preview <name>       print a theme's palette, and in Ghostty/kitty its screenshot
#   theme-switcher engine               path of the theme engine checkout in use
#   theme-switcher engine install <sha> fetch the engine at a pinned commit (the installer does this)
#
# State:
#   ~/.local/state/theme-switcher/current/theme/        generated configs (terminals include these)
#   ~/.local/state/theme-switcher/current/theme.name    current theme
#   ~/.local/state/theme-switcher/current/background    chosen image path as plain text; empty = solid color
#   ~/.local/share/theme-switcher/<theme>/backgrounds/  imported per-theme backgrounds
#   ~/.config/theme-switcher/themes/<name>/             your own and installed themes (overlay the engine's)
#   ~/.config/theme-switcher/themed/*.tpl               your own templates
#
# Environment:
#   THEME_SWITCHER_ENGINE         engine checkout to use instead of the managed one
#                                 (default ~/.local/share/theme-switcher/.engine)
#   THEME_SWITCHER_NO_DESKTOP=1   skip setting the macOS desktop picture
#   THEME_SWITCHER_TERMINALS      process names to repaint (default "ghostty alacritty kitty"; empty = none)

# The engine uses associative arrays; macOS ships bash 3.2.
if (( BASH_VERSINFO[0] < 5 )); then
  for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x $candidate ]] && exec "$candidate" "$0" "$@"
  done
  echo "theme-switcher: needs bash 5 (brew install bash)" >&2
  exit 1
fi

set -euo pipefail

# The engine's own name. Its repository is named after it, its scripts are
# <name>-theme-*, it reads <NAME>_PATH, and its renderer stages under
# ~/.local/state/<name> and ~/.config/<name>; this is the one place it appears.
ENGINE_NAME=omarchy
ENGINE_REPO="https://github.com/omacom/$ENGINE_NAME.git"
# `engine install` keeps a sparse checkout here, at the commit the installer pins in
# scripts/common. Theme names cannot start with a dot, so it cannot collide with
# a theme's imported backgrounds beside it.
ENGINE_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/theme-switcher/.engine"
ENGINE_PATH=${THEME_SWITCHER_ENGINE:-$ENGINE_HOME}
ENGINE_COLOR="$ENGINE_NAME-theme-color"
ENGINE_OSC="$ENGINE_NAME-theme-osc"
ENGINE_RENDER="$ENGINE_NAME-theme-set-templates"
ENGINE_FROM_ALACRITTY="$ENGINE_NAME-theme-colors-from-alacritty"
STATE_DIR="$HOME/.local/state/theme-switcher/current"
THEME_DIR="$STATE_DIR/theme"
NEXT_THEME_DIR="$STATE_DIR/next-theme"
BACKGROUND_STATE="$STATE_DIR/background"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/theme-switcher"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/theme-switcher"
USER_THEMES_DIR="$HOME/.config/theme-switcher/themes"
USER_TEMPLATES_DIR="$HOME/.config/theme-switcher/themed"

# Community themes: the engine's site lists their git repositories.
CATALOG_URL=${THEME_SWITCHER_CATALOG_URL:-https://$ENGINE_NAME.org/themes/}
# What a theme cloned from a git repo may not ship, because it can run code: a
# terminal config names the program the terminal launches, and editors load Lua
# and vscode.json. Colors are all theme-switcher needs from such a theme; these
# files are generated from its colors instead.
INSTALLED_THEME_DENIED=(alacritty.toml foot.ini ghostty.conf kitty.conf vscode.json)
DROPPED_FILES=()
LOCK_DIR="${TMPDIR:-/tmp}/theme-switcher.lock"

read -ra TERMINALS <<<"${THEME_SWITCHER_TERMINALS-ghostty alacritty kitty}"
IMAGE_PATTERN='\.(jpe?g|png|gif|bmp|webp|heic|tiff?)$'

die() {
  echo "theme-switcher: $*" >&2
  exit 1
}

require_engine() {
  [[ -f $ENGINE_PATH/bin/$ENGINE_RENDER ]] ||
    die "no theme engine at $ENGINE_PATH (run: theme-switcher engine install <sha>, or set THEME_SWITCHER_ENGINE)"
}

# Fetch only what theme-switcher reads (the engine's scripts, templates and
# themes) at one commit, without history. Pinned by full SHA, since a tag or
# branch can move under you. Rerunning at the installed commit does nothing.
install_engine() {
  local ref="$1"
  local dir="$ENGINE_HOME"

  [[ $ref =~ ^[0-9a-f]{40}$ ]] || die "engine install needs a full 40-character commit SHA: $ref"

  if [[ $(git -C "$dir" rev-parse HEAD 2>/dev/null || true) == "$ref" ]]; then
    echo "Theme engine already at ${ref:0:12}"
    return 0
  fi

  mkdir -p "$dir"
  if [[ ! -d $dir/.git ]]; then
    git -C "$dir" init -q
    git -C "$dir" remote add origin "$ENGINE_REPO"
  else
    git -C "$dir" remote set-url origin "$ENGINE_REPO"
  fi
  # Backgrounds stay out of the working tree; import_backgrounds reads them
  # from git on demand, so only the themes in use are ever downloaded.
  git -C "$dir" sparse-checkout set --no-cone /bin/ /default/themed/ /themes/ '!/themes/*/backgrounds/'
  git -C "$dir" fetch -q --depth 1 --filter=blob:none origin "$ref"
  git -C "$dir" checkout -q --force --detach FETCH_HEAD

  [[ $(git -C "$dir" rev-parse HEAD) == "$ref" ]] || die "engine checkout is not at $ref"
  ENGINE_PATH="$dir" require_engine
  echo "Theme engine installed at ${ref:0:12}"
}

# The engine's scripts start with #!/bin/bash, which is 3.2 on macOS, and call
# each other by name. Shims put them on PATH running under this bash instead.
#
# The renderer also hardcodes where it stages and where user templates live,
# under $HOME. It runs with a scratch HOME whose two directories are symlinks to
# this tool's own, so nothing is written outside ~/.local/state/theme-switcher.
ENGINE_SHIMS=""
engine() {
  local command="$1"
  shift

  if [[ -z $ENGINE_SHIMS ]]; then
    ENGINE_SHIMS=$(mktemp -d)
    local name
    for name in "$ENGINE_COLOR" "$ENGINE_OSC" "$ENGINE_RENDER" "$ENGINE_FROM_ALACRITTY"; do
      printf '#!/bin/sh\nexec "%s" "%s/bin/%s" "$@"\n' "$BASH" "$ENGINE_PATH" "$name" >"$ENGINE_SHIMS/$name"
      chmod +x "$ENGINE_SHIMS/$name"
    done

    mkdir -p "$ENGINE_SHIMS/home/.local/state/$ENGINE_NAME/current" "$ENGINE_SHIMS/home/.config/$ENGINE_NAME"
    ln -s "$NEXT_THEME_DIR" "$ENGINE_SHIMS/home/.local/state/$ENGINE_NAME/current/next-theme"
    ln -s "$USER_TEMPLATES_DIR" "$ENGINE_SHIMS/home/.config/$ENGINE_NAME/themed"
  fi

  env HOME="$ENGINE_SHIMS/home" "${ENGINE_NAME^^}_PATH=$ENGINE_PATH" PATH="$ENGINE_SHIMS:$PATH" \
    "$ENGINE_SHIMS/$command" "$@"
}

cleanup() {
  [[ -n $ENGINE_SHIMS ]] && rm -rf "$ENGINE_SHIMS"
  rmdir "$LOCK_DIR" 2>/dev/null || true
}

# macOS has no flock; mkdir is atomic. A lock older than a minute is from a run
# that died, since a theme switch takes well under a second.
take_lock() {
  local _
  for _ in {1..50}; do
    mkdir "$LOCK_DIR" 2>/dev/null && return 0
    if [[ -n $(find "$LOCK_DIR" -maxdepth 0 -mmin +1 2>/dev/null) ]]; then
      rmdir "$LOCK_DIR" 2>/dev/null || true
      continue
    fi
    sleep 0.1
  done
  die "another theme change is still running"
}

theme_name() {
  echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-'
}

current_theme() {
  cat "$STATE_DIR/theme.name" 2>/dev/null || true
}

list_themes() {
  local current dir name
  current=$(current_theme)

  for dir in "$ENGINE_PATH"/themes/*/ "$USER_THEMES_DIR"/*/; do
    [[ -d $dir ]] || continue
    basename "$dir"
  done | sort -u | while read -r name; do
    if [[ $name == "$current" ]]; then
      echo "* $name"
    else
      echo "  $name"
    fi
  done
}

# A theme installed with `theme-switcher install` is a stranger's git clone; one
# the user wrote (a plain directory, or a symlink to their own working copy) is
# trusted in full.
theme_is_cloned() {
  [[ ! -L $1 && -d $1/.git ]]
}

is_denied_file() {
  local name="$1" denied
  [[ $name == *.lua ]] && return 0
  for denied in "${INSTALLED_THEME_DENIED[@]}"; do
    [[ $name == "$denied" ]] && return 0
  done
  return 1
}

# Copy a cloned theme without what can run code, and without following any
# symlink: in a cloned theme one points wherever its author chose.
stage_cloned() {
  local source="$1" dest="$2" root="$3"
  local entry name

  mkdir -p "$dest"
  for entry in "$source"/*; do
    [[ -e $entry || -L $entry ]] || continue
    name=${entry##*/}
    [[ $source == "$root" && $name == "backgrounds" ]] && continue
    if [[ -L $entry ]] || is_denied_file "$name"; then
      DROPPED_FILES+=("${entry#"$root"/}")
    elif [[ -d $entry ]]; then
      stage_cloned "$entry" "$dest/$name" "$root"
    else
      cp "$entry" "$dest/$name"
    fi
  done
}

# Copy a theme directory into staging, minus its backgrounds: those are imported
# into ~/.local/share once rather than copied on every switch.
stage_from() {
  local source="$1"
  local entry

  [[ -d $source ]] || return 0
  if theme_is_cloned "$source"; then
    stage_cloned "$source" "$NEXT_THEME_DIR" "$source"
    return 0
  fi
  for entry in "$source"/*; do
    [[ -e $entry ]] || continue
    [[ $(basename "$entry") == "backgrounds" ]] && continue
    cp -R "$entry" "$NEXT_THEME_DIR/"
  done
}

# Themes from before colors.toml ship only an alacritty.toml. Its palette is read
# in a scratch directory and only the resulting colors.toml is staged, so the
# colors survive and the terminal config (which can name a program) does not.
stage_colors_from_alacritty() {
  local source="$1" scratch

  [[ ! -f $NEXT_THEME_DIR/colors.toml ]] || return 0
  [[ -f $source/alacritty.toml && ! -L $source/alacritty.toml ]] || return 0

  scratch=$(mktemp -d)
  cp "$source/alacritty.toml" "$scratch/alacritty.toml"
  engine "$ENGINE_FROM_ALACRITTY" "$scratch" >/dev/null 2>&1 || true
  [[ ! -f $scratch/colors.toml ]] || cp "$scratch/colors.toml" "$NEXT_THEME_DIR/colors.toml"
  rm -rf "$scratch"
}

# Fail when any {{ ... }} survives rendering: a literal placeholder in a config
# would otherwise fail inside the app, far from the template that caused it.
check_rendered() {
  local leftovers
  leftovers=$(grep -rIoE '\{\{[^}]*\}\}' "$NEXT_THEME_DIR" 2>/dev/null | sort -u || true)
  if [[ -n $leftovers ]]; then
    echo "theme-switcher: unresolved placeholders after rendering:" >&2
    sed "s|^$NEXT_THEME_DIR/|  |" <<<"$leftovers" >&2
    return 1
  fi
}

write_background_state() {
  local path="$1"
  local tmp

  mkdir -p "$STATE_DIR"
  tmp=$(mktemp "$STATE_DIR/.background.XXXXXX")
  printf '%s\n' "$path" >"$tmp"
  mv "$tmp" "$BACKGROUND_STATE"
}

read_background_state() {
  [[ -f $BACKGROUND_STATE && ! -L $BACKGROUND_STATE ]] || return 0
  head -n 1 "$BACKGROUND_STATE"
}

# An installed or hand-written theme carries its backgrounds in its own folder,
# so they are used in place, not copied. Only regular files count: find does
# not follow symlinks, and a cloned theme's backgrounds/ may not be one either.
# Engine themes keep theirs in git, so those are imported into ~/.local/share.
theme_backgrounds() {
  local theme="$1"
  local dir="$DATA_DIR/$theme/backgrounds"
  local own="$USER_THEMES_DIR/$theme/backgrounds"

  if [[ -d $own ]] && ! { theme_is_cloned "$USER_THEMES_DIR/$theme" && [[ -L $own ]]; }; then
    dir="$own"
  fi
  [[ -d $dir ]] || return 0
  find "$dir" -maxdepth 1 -type f | grep -iE "$IMAGE_PATTERN" | LC_ALL=C sort || true
}

# Backgrounds of the engine's themes. A full checkout (THEME_SWITCHER_ENGINE)
# has them on disk; the managed one leaves them out of the working tree, and git
# fetches just this theme's files from the partial clone on first read.
engine_backgrounds() {
  local theme="$1"
  local dir="$ENGINE_PATH/themes/$theme/backgrounds"

  if [[ -d $dir ]]; then
    find "$dir" -maxdepth 1 -type f -exec basename {} \; | LC_ALL=C sort
  elif git -C "$ENGINE_PATH" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$ENGINE_PATH" ls-tree --name-only HEAD "themes/$theme/backgrounds/" 2>/dev/null | sed 's|.*/||'
  fi
}

copy_engine_background() {
  local theme="$1"
  local name="$2"
  local dest="$3"
  local tmp

  if [[ -f $ENGINE_PATH/themes/$theme/backgrounds/$name ]]; then
    cp "$ENGINE_PATH/themes/$theme/backgrounds/$name" "$dest"
  else
    tmp=$(mktemp "$dest.XXXXXX")
    git -C "$ENGINE_PATH" cat-file blob "HEAD:themes/$theme/backgrounds/$name" >"$tmp"
    mv "$tmp" "$dest"
  fi
}

import_backgrounds() {
  local theme="$1"
  local dest="$DATA_DIR/$theme/backgrounds"
  local name copied=0
  local names=()

  mapfile -t names < <(engine_backgrounds "$theme")
  (( ${#names[@]} > 0 )) || return 0

  mkdir -p "$dest"
  for name in "${names[@]}"; do
    [[ -n $name && ! -e $dest/$name ]] || continue
    copy_engine_background "$theme" "$name" "$dest/$name"
    copied=$((copied + 1))
  done
  (( copied == 0 )) || echo "Imported $copied background(s) for $theme"
}

# A solid image in the palette background color, for the "no image" state. A
# 24-bit BMP needs no compression or checksums, so bash can write it; sips turns
# it into a PNG the desktop accepts. Named by color, because macOS does not
# reload a desktop picture whose path is unchanged.
solid_background() {
  local hex="${1#\#}"
  local out="$CACHE_DIR/solid-$hex.png"
  local bmp size=8 row pixel i

  [[ $hex =~ ^[0-9A-Fa-f]{6}$ ]] || return 1
  [[ -f $out ]] && { echo "$out"; return 0; }

  mkdir -p "$CACHE_DIR"
  bmp=$(mktemp "$CACHE_DIR/solid.XXXXXX")
  le32() { printf '\\x%02x\\x%02x\\x%02x\\x%02x' $(($1 & 255)) $((($1 >> 8) & 255)) $((($1 >> 16) & 255)) $((($1 >> 24) & 255)); }
  le16() { printf '\\x%02x\\x%02x' $(($1 & 255)) $((($1 >> 8) & 255)); }

  pixel=$(printf '\\x%s\\x%s\\x%s' "${hex:4:2}" "${hex:2:2}" "${hex:0:2}")
  row=""
  for ((i = 0; i < size; i++)); do row+="$pixel"; done
  {
    printf 'BM%b' "$(le32 $((54 + size * size * 3)))$(le32 0)$(le32 54)"
    printf '%b' "$(le32 40)$(le32 $size)$(le32 $size)$(le16 1)$(le16 24)$(le32 0)$(le32 $((size * size * 3)))$(le32 2835)$(le32 2835)$(le32 0)$(le32 0)"
    for ((i = 0; i < size; i++)); do printf '%b' "$row"; done
  } >"$bmp"

  sips -s format png "$bmp" --out "$out" >/dev/null
  rm -f "$bmp"
  echo "$out"
}

apply_desktop() {
  local path image

  [[ ${THEME_SWITCHER_NO_DESKTOP:-} == "1" ]] && return 0
  command -v osascript >/dev/null || return 0

  path=$(read_background_state)
  if [[ -n $path && -f $path ]]; then
    image="$path"
    # The engine ships .webp, which the desktop is not guaranteed to accept.
    if [[ ! ${path,,} =~ \.(jpe?g|png|heic)$ ]]; then
      image="$CACHE_DIR/desktop/$(basename "$(dirname "$(dirname "$path")")")-$(basename "${path%.*}").png"
      if [[ ! -f $image || $path -nt $image ]]; then
        mkdir -p "$CACHE_DIR/desktop"
        sips -s format png "$path" --out "$image" >/dev/null || image="$path"
      fi
    fi
  else
    image=$(solid_background "$(engine "$ENGINE_COLOR" --file "$THEME_DIR/colors.toml" background)") || return 0
  fi

  osascript - "$image" >/dev/null <<'APPLESCRIPT' || echo "theme-switcher: could not set the desktop picture (allow your terminal to control System Events)" >&2
on run argv
  tell application "System Events" to tell every desktop to set picture to POSIX file (item 1 of argv)
end run
APPLESCRIPT
}

# Config includes only reach new windows. Running ones are repainted by writing
# OSC color sequences to the TTY of each terminal's child (the shell, or
# /usr/bin/login on macOS); the terminal process itself does not own it.
repaint_terminals() {
  local osc terminal pid child tty
  local -A painted=()

  osc=$(engine "$ENGINE_OSC" "$THEME_DIR/colors.toml")
  [[ -n $osc ]] || return 0

  for terminal in "${TERMINALS[@]}"; do
    # pgrep exits 1 when nothing matches, which is the common case here.
    for pid in $(pgrep -x "$terminal" || true); do
      for child in $(pgrep -P "$pid" || true); do
        tty=$(ps -o tty= -p "$child" 2>/dev/null | tr -d ' ' || true)
        [[ $tty == ttys* || $tty == pts/* ]] || continue
        [[ -z ${painted[$tty]:-} ]] || continue
        painted[$tty]=1
        printf '%s' "$osc" >"/dev/$tty" 2>/dev/null || true
      done
    done
  done

  # OSC carries colors only; kitty re-reads the rest of its config on SIGUSR1.
  # Alacritty watches its imports itself. Ghostty is not signalled: on macOS it
  # has no documented external reload, and an unhandled signal would quit it.
  if pgrep -x kitty >/dev/null; then
    pkill -USR1 -x kitty || true
  fi
}

# tmux draws each pane on its own pty, which the terminal repaint above does not
# reach, and its status bar and borders use ANSI color names that resolve
# through the palette. So: give tmux the palette's default colors and cursor,
# send every pane the OSC palette, tell apps whether the theme is light, and
# redraw. Inside tmux, $TMUX picks the server; otherwise the default one.
repaint_tmux() {
  local foreground background cursor colorfgbg="15;0" osc tty session client pgid

  command -v tmux >/dev/null || return 0
  tmux list-sessions >/dev/null 2>&1 || return 0

  foreground=$(engine "$ENGINE_COLOR" --file "$THEME_DIR/colors.toml" foreground)
  background=$(engine "$ENGINE_COLOR" --file "$THEME_DIR/colors.toml" background)
  cursor=$(engine "$ENGINE_COLOR" --file "$THEME_DIR/colors.toml" cursor || true)
  [[ $(engine "$ENGINE_COLOR" --file "$THEME_DIR/colors.toml" mode) == "light" ]] && colorfgbg="0;15"

  tmux set-option -g window-style "fg=$foreground,bg=$background" 2>/dev/null || true
  tmux set-option -g window-active-style "fg=$foreground,bg=$background" 2>/dev/null || true
  # Apps such as nvim reset the cursor color (OSC 112); without a global value
  # tmux would then restore whatever the outer terminal started with.
  [[ -z $cursor ]] || tmux set-option -g cursor-colour "$cursor" 2>/dev/null || true

  tmux set-environment -g COLORFGBG "$colorfgbg" 2>/dev/null || true
  while IFS= read -r session; do
    [[ -z $session ]] || tmux set-environment -t "$session" COLORFGBG "$colorfgbg" 2>/dev/null || true
  done < <(tmux list-sessions -F '#{session_id}' 2>/dev/null)

  osc=$(engine "$ENGINE_OSC" "$THEME_DIR/colors.toml")
  while IFS= read -r tty; do
    [[ $tty == /dev/ttys* || $tty == /dev/pts/* ]] || continue
    printf '%s' "$osc" >"$tty" 2>/dev/null || true
    # Let full-screen apps in the pane (nvim, less) redraw with the new colors.
    pgid=$(ps -o tpgid= -t "${tty#/dev/}" 2>/dev/null | awk 'NF && $1 > 0 { print $1; exit }')
    [[ -z $pgid ]] || kill -WINCH "-$pgid" 2>/dev/null || true
  done < <(tmux list-panes -a -F '#{pane_tty}' 2>/dev/null | sort -u)

  while IFS= read -r client; do
    [[ -z $client ]] || tmux refresh-client -t "$client" 2>/dev/null || true
  done < <(tmux list-clients -F '#{client_name}' 2>/dev/null)
}

set_theme() {
  local name="$1"
  local backgrounds=()

  require_engine
  name=$(theme_name "$name")
  [[ -n $name && $name != .* && $name != */* ]] || die "invalid theme name: $1"
  [[ -d $ENGINE_PATH/themes/$name || -d $USER_THEMES_DIR/$name ]] || die "theme '$name' does not exist"

  take_lock

  rm -rf "$NEXT_THEME_DIR"
  mkdir -p "$NEXT_THEME_DIR"
  stage_from "$ENGINE_PATH/themes/$name"
  stage_from "$USER_THEMES_DIR/$name"
  stage_colors_from_alacritty "$USER_THEMES_DIR/$name"
  if (( ${#DROPPED_FILES[@]} > 0 )); then
    echo "Ignored from installed theme '$name' (it may not supply code): ${DROPPED_FILES[*]}" >&2
  fi
  if [[ ! -f $NEXT_THEME_DIR/colors.toml ]]; then
    rm -rf "$NEXT_THEME_DIR"
    die "theme '$name' has no colors.toml"
  fi

  if ! engine "$ENGINE_RENDER" || ! check_rendered; then
    rm -rf "$NEXT_THEME_DIR"
    die "theme '$name' was not applied; the current theme is unchanged"
  fi

  rm -rf "$THEME_DIR"
  mv "$NEXT_THEME_DIR" "$THEME_DIR"
  echo "$name" >"$STATE_DIR/theme.name"

  [[ -d $DATA_DIR/$name/backgrounds || -d $USER_THEMES_DIR/$name/backgrounds ]] || import_backgrounds "$name"
  mapfile -t backgrounds < <(theme_backgrounds "$name")
  write_background_state "${backgrounds[0]:-}"

  repaint_terminals
  repaint_tmux
  apply_desktop
  echo "Theme: $name"
}

bg_next() {
  local theme current next="" i
  local backgrounds=()

  theme=$(current_theme)
  [[ -n $theme ]] || die "no theme set yet"
  mapfile -t backgrounds < <(theme_backgrounds "$theme")
  (( ${#backgrounds[@]} > 0 )) || die "no backgrounds for $theme (try: theme-switcher bg import $theme)"

  current=$(read_background_state)
  next="${backgrounds[0]}"
  for i in "${!backgrounds[@]}"; do
    if [[ ${backgrounds[$i]} == "$current" ]]; then
      next="${backgrounds[$(((i + 1) % ${#backgrounds[@]}))]}"
      break
    fi
  done

  write_background_state "$next"
  apply_desktop
  echo "Background: $next"
}

bg_set() {
  local path="${1:-}"

  [[ -n $path ]] || die "usage: theme-switcher bg set <path>"
  [[ -f $path ]] || die "no such file: $path"
  path=$(cd "$(dirname "$path")" && pwd)/$(basename "$path")
  write_background_state "$path"
  apply_desktop
}

bg_import() {
  local theme dir

  require_engine
  if [[ -n ${1:-} ]]; then
    theme=$(theme_name "$1")
    [[ -n $(engine_backgrounds "$theme") ]] || die "the engine ships no backgrounds for '$theme'"
    import_backgrounds "$theme"
  else
    for dir in "$ENGINE_PATH"/themes/*/; do
      import_backgrounds "$(basename "$dir")"
    done
  fi
}

# --- community themes -----------------------------------------------------------

# "<display name><TAB><repo URL>" for each theme on the catalog page: every entry
# is a link to the theme's GitHub repo around its screenshot and name.
catalog_entries() {
  local html
  html=$(curl -fsSL "$CATALOG_URL") || die "could not fetch the theme catalog ($CATALOG_URL)"
  tr '\n' ' ' <<<"$html" |
    grep -oE '<a href="https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+"[^>]*>[[:space:]]*<img[^>]*>[[:space:]]*<span[^>]*>[^<]+</span>' |
    sed -E 's|^<a href="([^"]+)".*<span[^>]*>([^<]+)</span>$|\2'$'\t''\1|; s/&amp;/\&/g; s/&#39;|&#x27;/'"'"'/g; s/&quot;/"/g' || true
}

# The theme name a repo installs as, as the engine names it: the repo name,
# lowercased, minus an "<engine>-" prefix and a "-theme" suffix. It becomes a
# directory name, so it is held to the characters a theme name needs.
repo_theme_name() {
  local path="$1" name
  path="${path%/}"
  # scp-style git@host:owner/repo: drop the user@host: part before taking the basename.
  [[ $path != *"://"* && $path == *:* ]] && path="${path#*:}"
  name=$(basename -- "$path" .git | tr '[:upper:]' '[:lower:]')
  name="${name#"$ENGINE_NAME"-}"
  name="${name%-theme}"
  (LC_ALL=C; [[ $name =~ ^[a-z0-9_][a-z0-9._+-]*$ ]]) || return 1
  printf '%s' "$name"
}

# Only plain repository URLs: git runs a helper program for "<helper>::" URLs and
# for "<scheme>://" schemes it does not handle itself, and a leading "-" would
# be read as an option. The clone below also restricts git to these transports.
check_git_url() {
  local url="$1"
  [[ $url != -* && $url != *::* ]] || die "'$url' is not a repository URL"
  case "$url" in
    https://* | ssh://* | file://*) ;;
    git@*:*) ;;
    *) die "'$url' is not an https, ssh, git@host: or file:// repository URL" ;;
  esac
}

catalog() {
  local filter="${1:-}" display url name mark
  while IFS=$'\t' read -r display url; do
    [[ -n $url ]] || continue
    if [[ -n $filter ]] && ! grep -qiF -- "$filter" <<<"$display $url"; then
      continue
    fi
    name=$(repo_theme_name "$url") || continue
    mark=" "
    [[ -d $USER_THEMES_DIR/$name ]] && mark="*"
    printf '%s %-24s %-22s %s\n' "$mark" "$name" "$display" "$url"
  done < <(catalog_entries | LC_ALL=C sort -f)
}

install_theme() {
  local wanted="$1" url="" name display entry_url staging

  require_engine
  if [[ $wanted == *"://"* || $wanted == git@*:* ]]; then
    url="$wanted"
  else
    # A catalog theme, by its display name or the name it installs as.
    while IFS=$'\t' read -r display entry_url; do
      name=$(repo_theme_name "$entry_url") || continue
      if [[ $(tr '[:upper:]' '[:lower:]' <<<"$display") == "$(tr '[:upper:]' '[:lower:]' <<<"$wanted")" || $name == "$(theme_name "$wanted")" ]]; then
        url="$entry_url"
        break
      fi
    done < <(catalog_entries)
    [[ -n $url ]] || die "'$wanted' is not in the theme catalog (see: theme-switcher catalog)"
  fi

  check_git_url "$url"
  name=$(repo_theme_name "$url") || die "'$url' does not give a usable theme name"

  if [[ -e $USER_THEMES_DIR/$name ]] && ! theme_is_cloned "$USER_THEMES_DIR/$name"; then
    die "$USER_THEMES_DIR/$name exists and is not an installed theme; not replacing it"
  fi

  mkdir -p "$USER_THEMES_DIR"
  staging=$(mktemp -d "$USER_THEMES_DIR/.install.XXXXXX")
  echo "Installing $name from $url ..."
  if ! git -c protocol.allow=never -c protocol.https.allow=always -c protocol.ssh.allow=always \
    -c protocol.file.allow=always clone --quiet --depth 1 -- "$url" "$staging/$name"; then
    rm -rf "$staging"
    die "could not clone $url"
  fi
  rm -rf "${USER_THEMES_DIR:?}/$name"
  mv "$staging/$name" "$USER_THEMES_DIR/$name"
  rmdir "$staging"

  set_theme "$name"
}

remove_theme() {
  local name

  name=$(theme_name "$1")
  [[ -n $name && $name != .* && $name != */* ]] || die "invalid theme name: $1"
  [[ -e $USER_THEMES_DIR/$name || -L $USER_THEMES_DIR/$name ]] || die "'$name' is not an installed theme"

  rm -rf "${USER_THEMES_DIR:?}/$name" "${DATA_DIR:?}/$name"
  echo "Removed $name"
  [[ $(current_theme) != "$name" ]] || echo "It stays applied until you set another theme."
}

update_themes() {
  local dir updated=0

  for dir in "$USER_THEMES_DIR"/*/; do
    dir="${dir%/}"
    theme_is_cloned "$dir" || continue
    echo "Updating $(basename "$dir") ..."
    git -C "$dir" pull --quiet --ff-only || echo "theme-switcher: could not update $(basename "$dir")" >&2
    updated=$((updated + 1))
  done
  (( updated > 0 )) || echo "No installed themes to update."
}

# --- previews and the fzf picker -----------------------------------------------

# Where a theme's colors.toml and screenshot come from: the user's or installed
# copy first (it overlays the engine's), never through a symlink.
theme_file() {
  local name="$1" file="$2" dir
  for dir in "$USER_THEMES_DIR/$name" "$ENGINE_PATH/themes/$name"; do
    if [[ -f $dir/$file && ! -L $dir/$file ]]; then
      printf '%s' "$dir/$file"
      return 0
    fi
  done
  return 1
}

# A gallery theme's colors.toml and preview.png, fetched once from its repo
# without cloning it. A theme with only an alacritty.toml gets its colors
# derived in a scratch dir, as `install` does.
catalog_preview_files() {
  local url="$1" slug dir raw scratch
  [[ $url =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)$ ]] || return 1
  slug="${BASH_REMATCH[1]}__${BASH_REMATCH[2]%.git}"
  raw="https://raw.githubusercontent.com/${BASH_REMATCH[1]}/${BASH_REMATCH[2]%.git}/HEAD"
  dir="$CACHE_DIR/catalog/$slug"

  if [[ ! -f $dir/colors.toml ]]; then
    mkdir -p "$dir"
    if ! curl -fsSL -o "$dir/colors.toml" "$raw/colors.toml" 2>/dev/null; then
      rm -f "$dir/colors.toml"
      scratch=$(mktemp -d)
      if curl -fsSL -o "$scratch/alacritty.toml" "$raw/alacritty.toml" 2>/dev/null; then
        engine "$ENGINE_FROM_ALACRITTY" "$scratch" >/dev/null 2>&1 || true
        [[ ! -f $scratch/colors.toml ]] || cp "$scratch/colors.toml" "$dir/colors.toml"
      fi
      rm -rf "$scratch"
    fi
    curl -fsSL -o "$dir/preview.png" "$raw/preview.png" 2>/dev/null || rm -f "$dir/preview.png"
  fi
  printf '%s' "$dir"
}

# 24-bit color escapes from #rrggbb.
hex_fg() { local h="${1#\#}"; printf '\033[38;2;%d;%d;%dm' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }
hex_bg() { local h="${1#\#}"; printf '\033[48;2;%d;%d;%dm' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }

# Screenshots are shown only where they can be real images: Ghostty and kitty
# speak the kitty graphics protocol, drawn with `kitten icat
# --unicode-placeholder` so the image also survives tmux (allow-passthrough is
# on in tmux.conf). Inside tmux, TERM is tmux's own, so ask tmux which terminal
# the client is. Other terminals, such as Alacritty, show the palette only.
can_show_images() {
  local term="${TERM:-}"
  if [[ -n ${TMUX:-} ]]; then
    term=$(tmux display -p '#{client_termname}' 2>/dev/null || printf '%s' "$term")
  fi
  [[ $term == xterm-ghostty || $term == xterm-kitty ]] && command -v kitten >/dev/null 2>&1
}

draw_image() {
  local image="$1" cols="$2" rows="$3"
  # As fzf's own preview script: the last output line is a bare reset that fzf
  # would show as scrolling, so fold it into the line before.
  kitten icat --clear --transfer-mode=memory --unicode-placeholder --stdin=no \
    --place="${cols}x${rows}@0x0" "$image" 2>/dev/null | sed '$d' | sed $'$s/$/\033[m/'
}

# The palette as the terminals would show it: the 16 ANSI colors as swatches,
# then a prompt, some code and a selection on the theme's background.
render_preview() {
  local title="$1" colors="$2" image="${3:-}"
  local width="${FZF_PREVIEW_COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
  local height="${FZF_PREVIEW_LINES:-$(tput lines 2>/dev/null || echo 30)}"
  local -A c=()
  local key value i reset=$'\033[0m' bg fg

  while IFS=$'\t' read -r key value; do
    [[ $value =~ ^#[0-9A-Fa-f]{6}$ ]] && c[$key]="$value"
  done < <(engine "$ENGINE_COLOR" --file "$colors" --all 2>/dev/null)
  [[ -n ${c[background]:-} && -n ${c[foreground]:-} ]] || { echo "$title: no usable colors.toml"; return 0; }

  bg=$(hex_bg "${c[background]}")
  fg=$(hex_fg "${c[foreground]}")
  # A line of the given segments on the theme background, padded to the width.
  line() {
    local text="$1" plain
    plain=$(sed $'s/\033\\[[0-9;]*m//g' <<<"$text")
    printf '%s%s%s%s%*s%s\n' "$bg" "$fg" "$text" "$bg" $(( width > ${#plain} ? width - ${#plain} : 0 )) "" "$reset"
  }

  # The palette and sample below take 14 lines; the screenshot gets the rest.
  if [[ -n $image && -f $image ]] && (( height - 14 >= 6 )) && can_show_images; then
    draw_image "$image" "$width" $(( height - 14 )) || true
  fi

  line "  ${title}  ($(hex_fg "${c[accent]:-${c[blue]}}")${c[mode]:-dark}$fg)"
  line ""
  for i in 0 8; do
    local row="  " n
    for n in 0 1 2 3 4 5 6 7; do
      row+="$(hex_bg "${c[color$((i + n))]:-${c[background]}}")    $bg "
    done
    line "$row"
  done
  line ""
  line "  $(hex_fg "${c[cyan]}")~/projects$fg on $(hex_fg "${c[magenta]}") main$fg $(hex_fg "${c[green]}")❯$fg git status"
  line "  $(hex_fg "${c[green]}")modified:$fg   install.sh   $(hex_fg "${c[red]}")deleted:$fg Makefile"
  line ""
  line "  $(hex_fg "${c[magenta]}")function$fg $(hex_fg "${c[blue]}")greet$fg(name) {"
  line "    $(hex_fg "${c[muted]:-${c[color8]}}")// say hello$fg"
  line "    $(hex_fg "${c[magenta]}")return$fg $(hex_fg "${c[green]}")\"hi \"$fg + name + $(hex_fg "${c[yellow]}")42$fg"
  line "  }"
  line ""
  line "  $(hex_bg "${c[selection]:-${c[color8]}}")$(hex_fg "${c[bright_foreground]:-${c[foreground]}}") selected text $bg$fg  $(hex_fg "${c[accent]:-${c[blue]}}")accent$fg  $(hex_fg "${c[yellow]}")warning$fg  $(hex_fg "${c[red]}")error$fg"
}

preview_theme() {
  local name="$1" colors dir
  require_engine
  if [[ $name == --repo ]]; then
    dir=$(catalog_preview_files "${2:-}") || { echo "no preview for ${2:-}"; return 0; }
    [[ -f $dir/colors.toml ]] || { echo "$(basename "${2:-}"): its repo has no colors.toml or alacritty.toml"; return 0; }
    render_preview "$(repo_theme_name "$2" || basename "$2")" "$dir/colors.toml" "$dir/preview.png"
    return 0
  fi
  name=$(theme_name "$name")
  colors=$(theme_file "$name" colors.toml) || { echo "$name: no colors.toml"; return 0; }
  render_preview "$name" "$colors" "$(theme_file "$name" preview.png || true)"
}

pick_theme() {
  local self selected pos
  command -v fzf >/dev/null 2>&1 || die "the picker needs fzf (brew install fzf)"
  require_engine
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  if [[ ${1:-} == --catalog ]]; then
    selected=$(catalog | fzf --ansi --reverse --height 90% --prompt 'gallery theme> ' \
      --header 'Enter: install and apply   Esc: cancel   (first preview of a theme downloads its colors)' \
      --with-nth 1,2.. --preview "'$self' preview --repo {-1}" --preview-window 'right,65%,border-left') || return 0
    install_theme "$(awk '{print $NF}' <<<"$selected")"
    return 0
  fi

  # Start on the current theme.
  pos=$(list_themes | awk '{print $NF}' | grep -nxF -- "$(current_theme)" | cut -d: -f1 || true)
  pos=${pos:-1}
  selected=$(list_themes | fzf --ansi --reverse --height 90% --prompt 'theme> ' \
    --header 'Enter: apply   Esc: cancel   * = current' --bind "load:pos($pos)" \
    --preview "'$self' preview {-1}" --preview-window 'right,65%,border-left') || return 0
  set_theme "$(awk '{print $NF}' <<<"$selected")"
}

usage() {
  sed -n '3,41p' "$0" | sed 's/^# \{0,1\}//'
}

trap cleanup EXIT

case "${1:-}" in
  list) require_engine; list_themes ;;
  current) current_theme ;;
  engine)
    case "${2:-}" in
      "") require_engine; echo "$ENGINE_PATH" ;;
      install) [[ -n ${3:-} ]] || die "usage: theme-switcher engine install <sha>"; install_engine "$3" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  set) [[ -n ${2:-} ]] || die "usage: theme-switcher set <name>"; set_theme "$2" ;;
  catalog) catalog "${2:-}" ;;
  install) [[ -n ${2:-} ]] || die "usage: theme-switcher install <name|url>"; install_theme "$2" ;;
  remove) [[ -n ${2:-} ]] || die "usage: theme-switcher remove <name>"; remove_theme "$2" ;;
  update) update_themes ;;
  pick) pick_theme "${2:-}" ;;
  preview) [[ -n ${2:-} ]] || die "usage: theme-switcher preview <name>"; preview_theme "$2" "${3:-}" ;;
  bg)
    case "${2:-}" in
      next) bg_next ;;
      set) bg_set "${3:-}" ;;
      none) [[ -f $THEME_DIR/colors.toml ]] || die "no theme set yet"; write_background_state ""; apply_desktop ;;
      import) bg_import "${3:-}" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  -h | --help | help) usage ;;
  *) usage; exit 1 ;;
esac
